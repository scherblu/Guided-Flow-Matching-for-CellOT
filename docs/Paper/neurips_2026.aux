\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Qualitative comparison of guidance methods across three energy functions (rows). Columns show, from left to right: target distribution, ground truth $p'(x)$, and samples generated by each guidance method (CFM, sim-MC, cov-A, cov-G, MC, Learned (GM), CCFM). Red dots indicate samples in the guided target region; blue dots are the remaining samples.}}{3}{figure.caption.5}\protected@file@percent }
\newlabel{fig:synthetic_comparison}{{3}{3}{Qualitative comparison of guidance methods across three energy functions (rows). Columns show, from left to right: target distribution, ground truth $p'(x)$, and samples generated by each guidance method (CFM, sim-MC, cov-A, cov-G, MC, Learned (GM), CCFM). Red dots indicate samples in the guided target region; blue dots are the remaining samples}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Quantitative comparison of all guidance methods on four metrics shown on a logarithmic scale. Lower is better for all metrics: W2 distance, energy distance, $|1 - \text  {diversity trace ratio}|$, and off-manifold rate. The learned (GM) model achieves the lowest energy distance; MC guidance offers a strong balance across all metrics without requiring additional training.}}{3}{figure.caption.6}\protected@file@percent }
\newlabel{fig:metrics_comparison}{{4}{3}{Quantitative comparison of all guidance methods on four metrics shown on a logarithmic scale. Lower is better for all metrics: W2 distance, energy distance, $|1 - \text {diversity trace ratio}|$, and off-manifold rate. The learned (GM) model achieves the lowest energy distance; MC guidance offers a strong balance across all metrics without requiring additional training}{figure.caption.6}{}}
