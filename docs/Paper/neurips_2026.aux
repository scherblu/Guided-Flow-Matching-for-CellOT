\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Left, the energy function $J(x)$ of Eq.~\eqref  {eq:energy_function} selecting three of the eight Gaussian modes, where low values mark the preferred region. Right, the corresponding weight $e^{-J(x)}$, proportional to the guided target $p'(x) \propto p_1(x)\,e^{-J(x)}$. The three separated peaks show that only samples near the selected modes are preferred once guidance reweights the target distribution.}}{8}{figure.caption.3}\protected@file@percent }
\newlabel{fig:energy_functions}{{2}{8}{Left, the energy function $J(x)$ of Eq.~\eqref {eq:energy_function} selecting three of the eight Gaussian modes, where low values mark the preferred region. Right, the corresponding weight $e^{-J(x)}$, proportional to the guided target $p'(x) \propto p_1(x)\,e^{-J(x)}$. The three separated peaks show that only samples near the selected modes are preferred once guidance reweights the target distribution}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Qualitative comparison of guidance methods across three energy functions (rows), guiding toward one mode, toward three modes, and toward a contiguous arc of the moons distribution. Columns show the target distribution, the ground truth guided density $p'(x)$, and samples generated by the unguided base model and each guidance method. Blue points belong to the source distribution and red points belong to the target distribution. The path between each coupling is colored from blue to red along its way.}}{8}{figure.caption.4}\protected@file@percent }
\newlabel{fig:synthetic_comparison}{{3}{8}{Qualitative comparison of guidance methods across three energy functions (rows), guiding toward one mode, toward three modes, and toward a contiguous arc of the moons distribution. Columns show the target distribution, the ground truth guided density $p'(x)$, and samples generated by the unguided base model and each guidance method. Blue points belong to the source distribution and red points belong to the target distribution. The path between each coupling is colored from blue to red along its way}{figure.caption.4}{}}
