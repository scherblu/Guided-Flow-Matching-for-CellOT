\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Quantitative comparison of all seven methods on the three-mode setting of Figure~\ref {fig:synthetic_comparison}, using four metrics on a logarithmic scale where lower is always better. Learned guidance (GM) reaches the lowest W2 distance and energy distance. MC guidance offers the best overall balance among the training-free methods.}}{9}{figure.caption.5}\protected@file@percent }
\newlabel{fig:metrics_comparison}{{4}{9}{Quantitative comparison of all seven methods on the three-mode setting of Figure~\ref {fig:synthetic_comparison}, using four metrics on a logarithmic scale where lower is always better. Learned guidance (GM) reaches the lowest W2 distance and energy distance. MC guidance offers the best overall balance among the training-free methods}{figure.caption.5}{}}
